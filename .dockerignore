# Default deny. Only the accepted build and existing offline test inputs enter.
**
!Dockerfile
!.dockerignore
!package.json
!package-lock.json
!tsconfig.json
!src/
!src/**/
!src/**/*.ts
!test/
!test/*.test.js
!test/fixtures/
!test/fixtures/**/
!test/fixtures/**/*.js

# These rules come last: source/test allowances must not reinclude local secrets.
**/.env
**/.env.*
**/.project-control
**/.git
**/.aws
**/.ssh
**/.npmrc
**/.netrc
**/credentials
**/*credentials*
**/*secret*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/node_modules
**/dist
**/coverage
**/.cache
**/.npm
**/.codex
**/.agents
**/test-results
**/playwright-report
**/tmp
**/temp
**/*.tmp
**/*.log
